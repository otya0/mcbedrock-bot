<mxfile host="app.diagrams.net"><diagram id="system" name="mcbedrock-bot"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="900" pageHeight="790"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="user" value="&lt;b&gt;Your program&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="240" height="50" as="geometry"/></mxCell><mxCell id="root" value="&lt;b&gt;mcbedrock (bot.go, join.go)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;The only package your program imports&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="400" height="50" as="geometry"/></mxCell><mxCell id="mojang" value="&lt;b&gt;Mojang&amp;#x27;s data files&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;taken once by download-mojang-data&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="220" height="50" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Layer 2 (internal)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=15;verticalAlign=top;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="820" height="380" as="geometry"/></mxCell><mxCell id="act" value="&lt;b&gt;act: input&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Runs when your program asks&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="370" height="320" as="geometry"/></mxCell><mxCell id="record" value="&lt;b&gt;record: what the bot knows&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Remembers and answers. Calls nothing.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="470" y="235" width="370" height="200" as="geometry"/></mxCell><mxCell id="arrive" value="&lt;b&gt;arrive: when a packet arrives&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Reads it and writes the records;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;replies as a client does by itself&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="455" width="370" height="100" as="geometry"/></mxCell><mxCell id="link" value="&lt;b&gt;Layer 1: serverlink and join&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;join signs in and connects;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;serverlink sends packets and tells which arrived&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="615" width="440" height="70" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;Minecraft server&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="725" width="240" height="50" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;move&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;the keys and turning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="285" width="165" height="42" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;dig&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;left button on a block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="285" width="165" height="42" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;hit&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;left button on an entity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="337" width="165" height="42" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;place&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;right button: put a block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="337" width="165" height="42" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;use&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;right button: the held item&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="389" width="165" height="42" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;choose&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;the hotbar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="389" width="165" height="42" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;drop&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Q&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="441" width="165" height="42" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;say&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;the chat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="441" width="165" height="42" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;container&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;the windows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="493" width="165" height="42" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;respawn&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;the death screen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="493" width="165" height="42" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;self&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;the bot itself&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="285" width="165" height="42" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;contents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;items and windows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="285" width="165" height="42" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;blocks&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;blocks and biomes near the bot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="337" width="165" height="42" as="geometry"/></mxCell><mxCell id="s13" value="&lt;b&gt;names&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;block, item and biome names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="337" width="165" height="42" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;raw&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;every packet as it arrived&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="389" width="340" height="36" as="geometry"/></mxCell><mxCell id="e0" value="asks / reads" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="70" as="sourcePoint"/><mxPoint x="450" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="asks" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="160" as="sourcePoint"/><mxPoint x="330" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="reads" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="160" as="sourcePoint"/><mxPoint x="560" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="read by names" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="160" as="sourcePoint"/><mxPoint x="760" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="reads" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="300" as="sourcePoint"/><mxPoint x="470" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="sends" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="555" as="sourcePoint"/><mxPoint x="300" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="tells" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="615" as="sourcePoint"/><mxPoint x="510" y="555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="replies" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="555" as="sourcePoint"/><mxPoint x="620" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="writes" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="455" as="sourcePoint"/><mxPoint x="700" y="435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" value="packets" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="685" as="sourcePoint"/><mxPoint x="450" y="725" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>