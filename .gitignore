# Microsoft account tokens. A token file is the key to the account: never commit it.
*_token.json

# Build output
*.exe

# Experiments and research notes: keep them local. examples/hello, the
# smallest whole program, is the one example that is published.
examples/*
!examples/hello/

# Mojang's data, taken by cmd/download-mojang-data. It is Mojang's: never commit it.
mojang-*.json
